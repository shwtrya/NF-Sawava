        <button class="btn-secondary" style="flex:1; justify-content:center;" onclick="stopCrBulk()">Stop</button>
      </div>
      <div style="display:flex; justify-content:space-between; align-items:center; margin-top:8px;">
        <div id="cr-bulk-stats" style="font-size:12px; font-weight:600; color:var(--text-muted);"></div>
        <div style="display:flex; gap:6px;">
          <button class="btn-secondary" style="padding:4px 10px; font-size:11px;" onclick="exportCrHits()">Export Hits</button>
          <button class="btn-secondary" style="padding:4px 10px; font-size:11px;" onclick="copyCrHits()">Copy All Hits</button>
        </div>
      </div>
      <div id="cr-bulk-progress" style="margin-top:8px; display:none;">
        <div style="background:var(--bg-subtle); border-radius:6px; height:6px; overflow:hidden;">
          <div id="cr-progress-bar" style="background:var(--primary); height:100%; width:0%; transition:width 0.3s;"></div>
        </div>
      </div>
      <div id="cr-bulk-out" style="max-height:400px; overflow-y:auto; margin-top:12px;"></div>
    </div>
