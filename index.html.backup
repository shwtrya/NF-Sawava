            <div style="font-size:10px; color:#fda4af; text-transform:uppercase; letter-spacing:0.5px;">Dead</div>
            <div id="spotify-stat-dead" style="font-size:22px; font-weight:800; color:#f43f5e;">0</div>
          </div>
          <div style="background:rgba(245,158,11,0.1); border:1px solid rgba(245,158,11,0.25); border-radius:var(--radius-sm); padding:8px 12px;">
            <div style="font-size:10px; color:#fcd34d; text-transform:uppercase; letter-spacing:0.5px;">Error</div>
            <div id="spotify-stat-error" style="font-size:22px; font-weight:800; color:#f59e0b;">0</div>
          </div>
        </div>
