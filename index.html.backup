        <div style="font-weight:700; font-size:13px; color:var(--primary);">📊 Session Stats</div>
        <button class="btn-secondary" style="padding:3px 10px; font-size:10px;" onclick="resetSpotifyStats()">Reset</button>
      </div>
      <div style="display:flex; gap:16px; align-items:center;">
        <div style="position:relative; width:100px; height:100px; flex-shrink:0;">
          <canvas id="spotify-donut-chart" width="100" height="100"></canvas>
          <div style="position:absolute; inset:0; display:flex; flex-direction:column; align-items:center; justify-content:center; pointer-events:none;">
            <span id="spotify-donut-total" style="font-size:20px; font-weight:800; color:var(--text-primary);">0</span>
            <span style="font-size:9px; color:var(--text-muted); text-transform:uppercase; letter-spacing:1px;">Total</span>
          </div>
        </div>
        <div style="display:grid; grid-template-columns:1fr 1fr; gap:8px; flex:1;">
          <div style="background:rgba(16,185,129,0.1); border:1px solid rgba(16,185,129,0.25); border-radius:var(--radius-sm); padding:8px 12px;">
            <div style="font-size:10px; color:#6ee7b7; text-transform:uppercase; letter-spacing:0.5px;">Premium</div>
            <div id="spotify-stat-live" style="font-size:22px; font-weight:800; color:#10b981;">0</div>
          </div>
          <div style="background:rgba(56,189,248,0.1); border:1px solid rgba(56,189,248,0.25); border-radius:var(--radius-sm); padding:8px 12px;">
            <div style="font-size:10px; color:#7dd3fc; text-transform:uppercase; letter-spacing:0.5px;">Free</div>
            <div id="spotify-stat-free" style="font-size:22px; font-weight:800; color:#38bdf8;">0</div>
          </div>
