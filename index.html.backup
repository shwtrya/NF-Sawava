        <div style="display:flex; justify-content:space-between; font-size:11px; margin-bottom:4px;">
          <span style="color:var(--text-muted);">Hit Rate</span>
          <span id="spotify-hit-rate" style="font-weight:700; color:var(--primary);">0%</span>
        </div>
        <div style="background:var(--bg-subtle); border-radius:6px; height:6px; overflow:hidden;">
          <div id="spotify-hit-rate-bar" style="height:100%; width:0%; border-radius:6px; transition:width 0.4s; background:linear-gradient(90deg, #1DB954, #38bdf8);"></div>
        </div>
      </div>
