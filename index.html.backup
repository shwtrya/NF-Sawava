        <div style="display:flex; gap:6px;">
          <button class="btn-secondary" style="padding:4px 10px; font-size:11px;" onclick="exportSpotifyHits()">Export Hits</button>
          <button class="btn-secondary" style="padding:4px 10px; font-size:11px;" onclick="copySpotifyHits()">Copy All Hits</button>
        </div>
      </div>
      <div id="spotify-bulk-progress" style="margin-top:8px; display:none;">
        <div style="background:var(--bg-subtle); border-radius:6px; height:6px; overflow:hidden;">
          <div id="spotify-progress-bar" style="background:var(--primary); height:100%; width:0%; transition:width 0.3s;"></div>
        </div>
      </div>
      <div id="spotify-bulk-out" style="max-height:400px; overflow-y:auto; margin-top:12px;"></div>
    </div>
  </div>

